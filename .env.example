# ── Chreol Empire — variables d'environnement ────────────────────────────────
# Copiez ce fichier vers .env.local et renseignez les valeurs réelles.
# .env.local est ignoré par git : ne commitez jamais de secrets.

# ── Site ─────────────────────────────────────────────────────────────────────
# URL publique utilisée pour les liens des emails / webhooks.
NEXT_PUBLIC_SITE_URL=https://shop.chreolempire.com

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Campay (collecte Mobile Money) ───────────────────────────────────────────
CAMPAY_BASE_URL=https://demo.campay.net
CAMPAY_API_TOKEN=
CAMPAY_WEBHOOK_SECRET=

# ── Brevo (emails transactionnels) ───────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# ── Telegram (notifications admin) ───────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Espace admin ─────────────────────────────────────────────────────────────
ADMIN_PASSWORD=

# ── Sécurité interne ─────────────────────────────────────────────────────────
# Protège /api/notify-order et /api/check-duplicate :
#   • les appels navigateur de même origine passent automatiquement
#   • les appels serveur à serveur doivent envoyer le header x-internal-secret
# Générez une valeur : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_API_SECRET=

# Secret de signature des liens "marquer comme traité" (emails admin).
MARK_DONE_SECRET=

# ── Iwopay / Iwomipay (paiements Mobile Money + payout) ──────────────────────
IWOPAY_BASE_URL=https://www.pay.iwomitechnologies.com/api/iwomipay_prodv1
IWOPAY_USERNAME=
IWOPAY_PASSWORD=
# Paire de clés Orange Money (op_type credit / type om)
IWOPAY_KEY_OM=
IWOPAY_SECRET_OM=
# Paire de clés MTN MoMo (op_type credit / type momo)
IWOPAY_KEY_MOMO=
IWOPAY_SECRET_MOMO=
# URL appelée par Iwopay après validation du paiement (à déclarer côté Iwopay).
IWOPAY_CALLBACK_URL=https://shop.chreolempire.com/api/iwopay-webhook
# Optionnel : si défini, Iwopay doit appeler l'URL avec ?key=<secret>
# (ou envoyer le header x-iwopay-secret).
IWOPAY_WEBHOOK_SECRET=
